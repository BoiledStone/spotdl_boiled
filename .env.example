# Public defaults are stored in spotdl.config.json.
# Use this file only for private overrides or local secrets.

# Optional private overrides.
# SPOTDL_PLAYLIST_URL=https://open.spotify.com/playlist/...
# SPOTDL_OUTPUT_DIR=D:/download

# Optional: point to another .env file.
# BOT_ENV_FILE=C:\path\to\your\env.file

# Optional: yt-dlp browser cookie source. Firefox is selected automatically
# when a local Firefox profile exists. Set an empty value to disable auto-detection.
# BOT_YTDLP_COOKIES_BROWSER=firefox

# Optional: JavaScript runtime for current yt-dlp YouTube extraction.
# Deno is auto-detected before Node. You can force one with its executable path.
# BOT_YTDLP_JS_RUNTIME=deno:C:\path\to\deno.exe
# BOT_YTDLP_REMOTE_EJS=true

# Optional: Python executable used by the PowerShell launcher.
# SPOTDL_PYTHON=python

# Optional: number of tracks processed in parallel (1 to 5, default 2).
# SPOTDL_WORKERS=2

# Optional: number of ranked YouTube candidates tried after a failed download
# (1 to 8, default 6). Authentication failures stop immediately.
# SPOTDL_MAX_CANDIDATE_ATTEMPTS=6

# Optional: minimum score for a permissive YouTube fallback.
# SPOTDL_MIN_FALLBACK_SCORE=130

# Optional: max Spotify API rate-limit wait before falling back/failing.
# SPOTIFY_API_MAX_RETRY_AFTER_SECONDS=30

# Optional: internal Spotify web-player pagination.
# SPOTIFY_PATHFINDER_PAGE_SIZE=200
# SPOTIFY_PATHFINDER_PAGE_DELAY_SECONDS=0.2

# Optional: Spotify web-player token support.
# SPOTIFY_SP_DC=
# SPOTIFY_TOTP_SECRETS_URL=https://github.com/xyloflake/spot-secrets-go/blob/main/secrets/secretDict.json?raw=true
# SPOTIFY_TOTP_TIMEOUT_SECONDS=10

# Optional Spotify API credentials.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
