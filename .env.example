# Optional local env file used by the scripts.
# Copy to .env if you want to keep values in the repo folder.

# Spotify playlist to process.
# SPOTDL_PLAYLIST_URL=https://open.spotify.com/playlist/...

# Output folder for downloaded audio.
# SPOTDL_OUTPUT_DIR=C:\Users\Boiled\spotdl_github\downloads

# Optional: point to another .env file.
# BOT_ENV_FILE=C:\path\to\your\env.file

# Optional: yt-dlp browser cookie source.
# BOT_YTDLP_COOKIES_BROWSER=firefox

# Optional: Python executable used by the PowerShell launcher.
# SPOTDL_PYTHON=python

# Optional Spotify API credentials.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
